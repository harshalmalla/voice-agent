# Live Voice RAG Agent — environment template
#
# Copy this file to `.env` in the project root and fill in the values:
#
#     cp .env.example .env
#
# `.env` is gitignored; this file is not. Never put a real key in here.
#
# Everything below is read in exactly one place, `app/config.py`. Nothing else
# in the codebase calls os.getenv, so this file and that module are the
# complete list of things the app can be configured with.
#
# Only the four keys in the REQUIRED SECRETS section have to be set to run the
# app; every other variable has a working default and exists so you can change
# behaviour without editing code. Config itself never fails on a missing value
# — importing `app.config` works with no `.env` at all — so a missing key
# surfaces at the moment the feature that needs it is used, with a message
# naming the variable (`app.config.require`).


# =============================================================================
# REQUIRED SECRETS
# =============================================================================

# Google AI Studio API key. REQUIRED — without it the agent cannot answer at
# all, and ingestion cannot embed anything, because both the Gemini chat model
# and the embedding model are behind this one key.
# Get one free at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-studio-api-key-here

# MongoDB Atlas connection string. REQUIRED — Atlas Vector Search is the store
# for both the ingested documents and the conversation memory, so without it
# there is no retrieval and no recall.
# Atlas UI -> your cluster -> Connect -> Drivers -> copy the SRV string, then
# replace <username>/<password> with a database user's credentials and
# URL-encode any special characters in the password.
# A free M0 cluster is enough. https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@your-cluster.example.mongodb.net/?retryWrites=true&w=majority

# Tavily web-search API key. OPTIONAL.
# Without it: the app still runs, but the agent's `web_search` tool is
# unavailable, so questions needing live information from the internet fall
# back to what the model already knows and to your ingested documents.
# Free tier at https://tavily.com
TAVILY_API_KEY=your-tavily-api-key-here

# Sarvam AI API key. OPTIONAL, and only matters for Indian regional languages.
# Without it: English is completely unaffected (English never touches Sarvam).
# Regional speech degrades in two places at once — transcription falls back to
# the local faster-whisper transcript, whose non-English quality is weak, and
# the spoken reply falls back to the browser's own speech synthesis, which
# reads a Hindi or Tamil sentence with an English voice.
# Sign up at https://www.sarvam.ai
SARVAM_API_KEY=your-sarvam-api-key-here


# =============================================================================
# GEMINI MODELS — optional, sensible defaults in app/config.py
# =============================================================================

# The model that answers. Tried first on every turn.
GEMINI_MODEL_PRIMARY=gemini-3.5-flash

# The model used when the primary is rate-limited or unavailable. Keep it a
# lighter model than the primary: the point is that it has its own separate
# quota, so a busy primary degrades the answer instead of losing the turn.
GEMINI_MODEL_FALLBACK=gemini-3.5-flash-lite

# The embedding model, used for both ingestion and query embedding.
# CHANGING THIS INVALIDATES YOUR INDEX. Vectors from two different models are
# not comparable, so you must re-run `python -m scripts.ingest_docs` and clear
# the memory collection after changing it — and keep EMBEDDING_DIMENSION below
# in step with whatever the new model outputs.
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Width of the vectors the embedding model produces. Must match both the model
# above and the `numDimensions` of the Atlas vector index; a mismatch fails at
# search time, not at write time.
EMBEDDING_DIMENSION=768


# =============================================================================
# SPEECH TO TEXT — local faster-whisper, optional
# =============================================================================

# Whisper model size: tiny, base, small, medium, large-v3. Downloaded and
# cached on first use. Bigger is more accurate and slower; `base` is the
# balance that keeps a live voice turn feeling responsive on a laptop CPU.
WHISPER_MODEL_SIZE=base

# Quantization for the local model: int8 (fast, CPU-friendly), int8_float16,
# float16 (GPU), float32. Leave as int8 unless you have a GPU.
WHISPER_COMPUTE_TYPE=int8

# How confident faster-whisper's language detection must be before the audio is
# re-transcribed through Sarvam. Below this, the local transcript is kept
# rather than spending a paid call on a guess. 0.0-1.0.
LANGUAGE_DETECTION_MIN_CONFIDENCE=0.5


# =============================================================================
# SARVAM — optional, only used when SARVAM_API_KEY is set
# =============================================================================

SARVAM_API_BASE_URL=https://api.sarvam.ai

# Speech-to-text model, used only for detected regional-language audio.
SARVAM_STT_MODEL=saaras:v3

# Text-to-speech model and voice, used only for non-English replies.
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh


# =============================================================================
# DATABASE — optional
# =============================================================================

# Database name inside the Atlas cluster. The `documents` and `memory`
# collection names and the `vector_index` index name are NOT configurable —
# they are constants in app/config.py, because the Atlas index definition has
# to be created against those exact names.
MONGODB_DB_NAME=voice_agent


# =============================================================================
# RETRIEVAL AND CHUNKING — optional
# =============================================================================

# Target characters per chunk at ingestion time, and how much consecutive
# chunks overlap so a sentence split across a boundary is still retrievable
# whole from one side of it.
# CHANGING EITHER REQUIRES RE-INGESTING; existing chunks keep their old shape.
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# How many chunks each vector search returns. Applied to the document search
# and the memory recall separately, so the prompt can carry up to twice this.
# Higher means more context and more tokens paid for on every single turn.
RETRIEVAL_TOP_K=4


# =============================================================================
# CONVERSATION AND AGENT BEHAVIOUR — optional
# =============================================================================

# How many recent exchanges are replayed verbatim into each prompt. This window
# is deliberately small: older turns are not lost, they are recalled by meaning
# from the memory collection instead. See app/services/session_manager.py.
MAX_HISTORY_TURNS=12

# Hard cap on how many times one turn may loop through call-model / run-tools.
# This is a cost and safety limit, not a tuning knob — without it, a model that
# keeps re-calling a tool is an unbounded loop of paid API calls with a prompt
# that grows on every pass, while the user waits in silence.
MAX_TOOL_ITERATIONS=5

# Results requested per `web_search` tool call (requires TAVILY_API_KEY).
WEB_SEARCH_MAX_RESULTS=5

# Longest reminder the agent will accept, in seconds. Default 86400 = 24 hours.
# Reminders live in memory in the server process and are cancelled when the
# session closes, so a reminder longer than the process's uptime never fires.
MAX_REMINDER_DELAY_SECONDS=86400


# =============================================================================
# LOGGING — optional
# =============================================================================

# DEBUG, INFO, WARNING, ERROR or CRITICAL. DEBUG includes the per-request
# provider calls and is the right setting when a turn is misbehaving.
LOG_LEVEL=INFO
